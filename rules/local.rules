alert http any any -> any any (msg:"LOCAL Possible SQL UNION SELECT in URI"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; within:32; priority:1; sid:1000001; rev:1;)
alert http any any -> any any (msg:"LOCAL Possible script injection in URI"; flow:established,to_server; http.uri; content:"<script"; nocase; priority:2; sid:1000002; rev:1;)
alert http any any -> any any (msg:"LOCAL Sensitive passwd path in raw URI"; flow:established,to_server; http.uri.raw; content:"/etc/passwd"; nocase; priority:2; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"LOCAL High SYN frequency possible scan"; flags:S; flow:stateless; detection_filter:track by_src,count 20,seconds 10; priority:2; sid:1000004; rev:1;)
alert dns any any -> any any (msg:"LOCAL Suspicious long DNS query"; dns.query; bsize:>100; priority:3; sid:1000005; rev:1;)
